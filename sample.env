# Port the dashboard and API listen on (default: 30004)
PORT=30004

# --- SMS gateway ---
# Applications submit SMS to POST /api/sms with a Send key (create one on the dashboard's API keys page).
# Max POST /api/sms requests per minute per client IP (default: 120)
# SMS_RATE_LIMIT=120

# --- Receiving mail (SMTP) ---
# Point your app's SMTP settings at this port: plain SMTP, no TLS (see README). Every message is
# stored; nothing is ever delivered.
# SMTP_PORT=1025
# Interface to listen on (default: all of them)
# SMTP_HOST=0.0.0.0
# Optional: require clients to log in. Without these, any (or no) credentials are accepted.
# SMTP_USERNAME=mailer
# SMTP_PASSWORD=a-long-random-password
# Largest message accepted, in MB (default: 10). Larger ones are rejected with 552.
# MAX_EMAIL_SIZE_MB=10
# Special recipients fail on purpose (reject@ 550, tempfail@ 451, full@ 452, slow@ delay, datafail@ 554 at DATA).
# Set to false to treat them as ordinary addresses.
# SMTP_SIMULATE=true
# Only accept mail for these domains; other recipients are refused with 550. Comma separated:
# example.com (that domain only), *.example.com (its subdomains). Empty accepts everything.
# SMTP_ALLOWED_DOMAINS=example.com,*.staging.test

# --- SMTP over TLS (optional) ---
# PEM files. With both set the server offers STARTTLS on SMTP_PORT (plain connections still work).
# SMTP_TLS_KEY=./certs/key.pem
# SMTP_TLS_CERT=./certs/cert.pem
# A second port that is encrypted from the first byte (like 465); needs the key and certificate.
# SMTP_TLS_PORT=1465
# Or let the server get and renew a Let's Encrypt certificate itself (instead of SMTP_TLS_KEY / SMTP_TLS_CERT).
# Needs a domain on Cloudflare and an API token with Zone:Read and DNS:Edit. See README, "TLS".
# ACME_DOMAINS=mail.example.com
# ACME_EMAIL=you@example.com
# CLOUDFLARE_API_TOKEN=
# ACME_STAGING=true     # test against Let's Encrypt staging first (certificates are not trusted)
# ACME_RENEW_DAYS=30    # renew when fewer than this many days are left
# ACME_DIR=./data/certs # where the key and certificate are kept (/app/data/certs in Docker)

# --- Relay to a real mail server (optional) ---
# Also forwards each message, but ONLY to the recipients in RELAY_ALLOW. RELAY_ALLOW is required with
# RELAY_HOST, so this can never become an open relay. Addresses, domains or *.domains, comma separated.
# RELAY_HOST=smtp.example.net
# RELAY_PORT=587
# RELAY_SECURE=false
# RELAY_USER=
# RELAY_PASSWORD=
# RELAY_FROM=testing@mycompany.com
# RELAY_ALLOW=me@example.com,mycompany.com

# --- Operations ---
# GET /metrics (Prometheus; needs a Read key or the admin token). Set to false to turn it off.
# METRICS=false

# --- Inspection ---
# Lets an admin use "Check links" on an email: the server then requests the URLs found in it.
# LINK_CHECK=false

# --- Webhook ---
# POST a JSON summary (with the detected code and links) to this URL for every stored email.
# Delivery is best effort: 5 second timeout, no retries.
# WEBHOOK_URL=https://ci.example.com/hooks/email
# Optional: sign requests with X-Signature-256: sha256=<HMAC-SHA256 of the body>
# WEBHOOK_SECRET=a-long-random-secret

# --- Authentication (required unless AUTH_DISABLED=true) ---
# Generate random values, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Dashboard sign-in (username defaults to "admin")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Optional read-only dashboard accounts: they can view and search emails and SMS, but can't send tests, delete,
# or see API keys. username:password pairs, comma-separated (passwords 8+ characters, no commas).
# VIEWER_USERS=alice:a-long-password,bob:another-long-password

# Signs dashboard session cookies (32+ characters). Changing it signs everyone out, and API keys
# created in the dashboard can no longer be shown or copied (they keep working).
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# API keys: create them in the dashboard (API keys page), where you can also copy them at any time.
# A Send key lets an app submit SMS (POST /api/sms). A Read key lists emails and SMS and reads codes and
# links; it can be limited to some email inboxes. Either is an X-API-Key header or Authorization: Bearer <key>.

# Optional: a token with full API access (including deleting messages), for scripts (16+ characters).
# For tests that only read messages, a Read key from the dashboard is the safer choice.
#   curl -H "Authorization: Bearer $ADMIN_TOKEN" "http://localhost:30004/api/emails/latest?to=user@example.com"
# ADMIN_TOKEN=

# Dashboard session lifetime in hours (default: 12)
# SESSION_TTL_HOURS=12

# Local development only: turns off all authentication
# AUTH_DISABLED=true

# --- Operations ---
# Set when running behind a reverse proxy (number of proxy hops, e.g. 1) so client IPs and HTTPS are detected
# TRUST_PROXY=1

# Max POST /api/emails/test requests per minute per client IP (default: 120)
# API_RATE_LIMIT=120

# Delete emails and SMS older than this many days (default: 0 = keep forever)
# RETENTION_DAYS=30

# Directory for log files (default: ./logs)
# LOG_DIR=./logs

# Set to false to log to stdout only (no log files)
# LOG_TO_FILE=true

# --- Database ---
# DB_TYPE picks the database: sqlite (default), postgres, or mysql.
DB_TYPE=sqlite

# SQLite: nothing else to set. The file defaults to ./messaging-db.sqlite (in Docker: /app/data/messaging-db.sqlite).
# Leave SQLITE_PATH unset when running in Docker.
# SQLITE_PATH=./messaging-db.sqlite

# PostgreSQL: the same PG_* variables are used whether the database is the bundled container or
# any other server. Only PG_HOST (and possibly PG_SSL) changes:
#
#   Setup                                   PG_HOST                       Also
#   Bundled container (compose --profile)   postgres                      docker compose --profile postgres up -d
#   Server on the Docker host               host.docker.internal          -
#   Server elsewhere / hosted (Neon, RDS…)  its hostname or IP            usually PG_SSL=true
#   Running without Docker, local server    localhost                     -
#
# Never use localhost inside Docker: there it means the app's own container.
# DB_TYPE=postgres
# PG_HOST=postgres
# PG_PORT=5432
# PG_USER=mail
# PG_PASSWORD=change-me
# PG_DATABASE=mail
# TLS for the connection: false (default), true (verify the server certificate), or no-verify (self-signed)
# PG_SSL=false
# Extra CA certificate to trust, as a PEM file path (e.g. the AWS RDS bundle mounted into the container)
# PG_SSL_CA=

# MySQL: same idea with MYSQL_* (MYSQL_HOST follows the same rules as PG_HOST above;
# there is no bundled MySQL container). Attachments are stored in the database, so keep the server's
# max_allowed_packet at least as large as MAX_EMAIL_SIZE_MB.
# DB_TYPE=mysql
# MYSQL_HOST=host.docker.internal
# MYSQL_PORT=3306
# MYSQL_USER=mail
# MYSQL_PASSWORD=change-me
# MYSQL_DATABASE=mail
# MYSQL_SSL=false
# MYSQL_SSL_CA=
#
# The database itself (PG_DATABASE / MYSQL_DATABASE) must already exist on an external server;
# the tables are created automatically on startup.
